---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Sakar Upadhyaya Khatiwada" description="The page you are looking for does not exist.">
	<main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-8 pt-32 pb-20">
		<div class="max-w-md">
			<span class="font-label text-sm uppercase tracking-widest text-primary font-bold mb-4 block">404 Error</span>
			<h1 class="text-6xl font-headline font-black text-on-surface mb-6">Page Not Found</h1>
			<p class="text-on-surface-variant text-lg leading-relaxed mb-8">
				Sorry, the page you're looking for doesn't exist or has been moved.
			</p>
			<a href="/" class="inline-flex items-center gap-2 bg-primary text-on-primary px-8 py-4 rounded-2xl font-headline font-bold hover:scale-105 transition-all">
				Return Home
			</a>
		</div>
	</main>
</BaseLayout>
