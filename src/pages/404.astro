---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<script is:inline>
  (function() {
    const path = window.location.pathname;
    if (path !== '/' && (path.endsWith('/') || path.endsWith('.html'))) {
      const cleanPath = path.replace(/\.html$/, '').replace(/\/+$/, '') + window.location.search + window.location.hash;
      window.location.replace(cleanPath);
    }
  })();
</script>

<BaseLayout title="Page Not Found | Sakar Upadhyaya Khatiwada" description="The page you are looking for does not exist.">
	<main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-8 pt-32 pb-20">
		<div class="max-w-md">
			<span class="font-label text-sm uppercase tracking-widest text-emerald-700 dark:text-emerald-400 font-bold mb-4 block">404 Error</span>
			<h1 class="text-5xl sm:text-6xl font-headline font-black text-slate-900 dark:text-white mb-6">Page Not Found</h1>
			<p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed mb-8">
				Sorry, the page you're looking for doesn't exist or has been moved.
			</p>
			<a href="/" class="inline-flex items-center gap-2 bg-emerald-600 text-white px-8 py-4 rounded-full font-headline font-bold hover:bg-emerald-700 hover:scale-105 transition-all shadow-lg shadow-emerald-600/20">
				Return Home
			</a>
		</div>
	</main>
</BaseLayout>
