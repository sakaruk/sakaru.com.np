---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentYear = new Date().getFullYear();
const experienceYears = currentYear - 2013;
---
<BaseLayout 
    title="Zendesk Solution Architect & Shopify Engineer | Sakar Upadhyaya Khatiwada"
    description={`Sakar Upadhyaya Khatiwada — Zendesk Solution Architect & Shopify Engineer based in Nepal with ${experienceYears}+ years of experience designing scalable SaaS integrations, custom Zendesk apps, and high-performance e-commerce solutions.`}
>
    <style>
        .hero-gradient {
            background-image: linear-gradient(to right, #008060, #0f766e);
        }
    </style>

	<main class="pt-24 min-h-screen">
        <!-- Hero Section -->
        <section class="relative flex flex-col justify-center px-8 max-w-7xl mx-auto pb-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-12 z-10 flex flex-col items-center justify-center text-center gap-10">
                    <div class="animate-fade-in-up">
                        <div class="inline-flex items-center space-x-2.5 px-4 py-2 rounded-full bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20 font-label text-xs font-bold uppercase tracking-widest mb-8">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                            </span>
                            <span>Zendesk & Shopify Engineer</span>
                        </div>
                        
                        <h1 class="text-4xl md:text-6xl lg:text-7xl font-headline font-black text-slate-900 dark:text-white leading-tight mb-8">
                            <span class="text-transparent bg-gradient-to-r from-emerald-700 via-teal-700 to-emerald-900 dark:from-emerald-400 dark:to-teal-300 bg-clip-text">Sakar</span> Upadhyaya Khatiwada <br class="hidden md:block"/>
                            <span class="text-xl md:text-2xl block mt-4 font-bold text-slate-600 dark:text-slate-300">Engineering the future of <span class="text-emerald-700 dark:text-emerald-400">Customer Experience</span> and <span class="text-emerald-700 dark:text-emerald-400">Management Systems</span></span>
                        </h1>
                        
                        <!-- Social Presence Below Name -->
                        <div class="flex justify-center gap-4 mb-8">
                            <a class="w-12 h-12 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-600 hover:text-white hover:border-emerald-600 hover:scale-110 flex items-center justify-center transition-all duration-300 shadow-sm" href="https://github.com/sakaruk" aria-label="GitHub">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
                            </a>
                            <a class="w-12 h-12 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-600 hover:text-white hover:border-emerald-600 hover:scale-110 flex items-center justify-center transition-all duration-300 shadow-sm" href="https://x.com/sakaruk" aria-label="Twitter">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.005 4.15H5.059z"/></svg>
                            </a>
                            <a class="w-12 h-12 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-600 hover:text-white hover:border-emerald-600 hover:scale-110 flex items-center justify-center transition-all duration-300 shadow-sm" href="https://linkedin.com/in/sakaruk" aria-label="LinkedIn">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                    </div>
                    
                    <div class="animate-fade-in-up" style="animation-delay: 0.2s;">
                        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 font-body leading-relaxed max-w-4xl mx-auto">
                            Over {experienceYears} years of engineering have shaped me into a <span class="text-emerald-700 dark:text-emerald-400 font-bold">Web-Based Solutions Architect</span> who thrives at the intersection of functionality and scalability. I design and build systems that are robust, maintainable, and genuinely move the needle for businesses. My core focus lies in <span class="text-emerald-700 dark:text-emerald-400 font-bold">Customer Experience (CX)</span> and <span class="text-emerald-700 dark:text-emerald-400 font-bold">E-commerce</span> — engineering custom apps, themes, and deep integrations within the <span class="text-emerald-700 dark:text-emerald-400 font-bold">Zendesk</span> and <span class="text-emerald-700 dark:text-emerald-400 font-bold">Shopify</span> ecosystems.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Identity Section (Bento Grid) -->
        <section class="py-12 px-8 max-w-7xl mx-auto" id="work">
            <div class="mb-12">
                <h2 class="text-4xl md:text-5xl font-headline font-black text-slate-900 dark:text-white mb-4">Core Specializations</h2>
                <div class="h-1.5 w-20 bg-emerald-600 rounded-full"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Developer - The Digital Integrator -->
                <div class="md:col-span-2 group relative overflow-hidden bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-[2rem] p-10 hover:border-emerald-500/40 hover:shadow-xl shadow-sm transition-all duration-300">
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 flex items-center justify-center mb-6 text-emerald-700 dark:text-emerald-400">
                            <span class="material-symbols-outlined text-3xl" data-icon="integration_instructions">integration_instructions</span>
                        </div>
                        <h3 class="text-3xl font-headline font-black text-slate-900 dark:text-white mb-4">The Digital Integrator</h3>
                        <p class="text-slate-600 dark:text-slate-300 text-lg max-w-lg mb-8 leading-relaxed">
                            I connect diverse business systems to unlock compounding value for organizations. I build the integration layer that allows your entire SaaS ecosystem to operate as a single, efficient organism — eliminating silos and maximizing throughput.
                        </p>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-4 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700 rounded-full text-xs font-label font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Zendesk</span>
                            <span class="px-4 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700 rounded-full text-xs font-label font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Shopify</span>
                            <span class="px-4 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700 rounded-full text-xs font-label font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">APIs & Automations</span>
                            <span class="px-4 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700 rounded-full text-xs font-label font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Zapier, n8n, Make</span>
                            <span class="px-4 py-1.5 bg-slate-50 dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700 rounded-full text-xs font-label font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Custom Apps</span>
                        </div>
                    </div>
                </div>

                <!-- Zendesk Expert -->
                <div class="group relative overflow-hidden bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-[2rem] p-10 hover:border-emerald-500/40 hover:shadow-xl shadow-sm transition-all duration-300">
                    <div class="w-14 h-14 rounded-2xl bg-teal-50 dark:bg-teal-950/40 flex items-center justify-center mb-6 text-teal-700 dark:text-teal-400">
                        <span class="material-symbols-outlined text-3xl" data-icon="support_agent">support_agent</span>
                    </div>
                    <h3 class="text-3xl font-headline font-black text-slate-900 dark:text-white mb-4">Zendesk Expert</h3>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                        Optimizing enterprise support workflows through process audits, smart native configurations, and targeted engineering. I extend Zendesk with custom apps that bridge business logic via APIs and AI.
                    </p>
                    <div class="mt-auto pt-4 flex items-center gap-2">
                        <span class="font-label font-bold text-xs uppercase tracking-widest text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-3 py-1 rounded-md border border-emerald-200/60 dark:border-emerald-800/50">Solution Architect</span>
                    </div>
                </div>

                <!-- Shopify Engineer -->
                <div class="group relative overflow-hidden bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-[2rem] p-10 hover:border-emerald-500/40 hover:shadow-xl shadow-sm transition-all duration-300">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 flex items-center justify-center mb-6 text-emerald-700 dark:text-emerald-400">
                        <span class="material-symbols-outlined text-3xl" data-icon="shopping_bag">shopping_bag</span>
                    </div>
                    <h3 class="text-3xl font-headline font-black text-slate-900 dark:text-white mb-4">Shopify Engineer</h3>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                        Specializing in Shopify App Development, Theme Customization, and SEO optimization. From standalone stores to fully connected, scalable e-commerce ecosystems built for performance.
                    </p>
                    <div class="mt-auto pt-4 border-t border-slate-100 dark:border-slate-800">
                        <div class="text-[10px] font-label font-bold uppercase tracking-widest text-slate-400 mb-1">Focus</div>
                        <div class="text-base font-headline font-extrabold text-slate-800 dark:text-slate-200">App Development & SEO</div>
                    </div>
                </div>

                <!-- Work Showcase -->
                <div class="md:col-span-2 group relative overflow-hidden bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-[2rem] p-10 hover:border-emerald-500/40 hover:shadow-xl shadow-sm transition-all duration-300">
                    <div class="flex flex-col justify-between h-full">
                        <div>
                            <div class="flex justify-between items-start mb-8">
                                <h3 class="text-3xl font-headline font-black text-slate-900 dark:text-white leading-tight">
                                    Solving SaaS fragmentation <br/> with unified engineering.
                                </h3>
                                <span class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 p-3.5 rounded-2xl border border-emerald-100 dark:border-emerald-900/40">
                                    <span class="material-symbols-outlined text-3xl" data-icon="settings_input_component">settings_input_component</span>
                                </span>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div class="p-6 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-slate-800">
                                    <div class="text-3xl font-headline font-black text-emerald-700 dark:text-emerald-400 mb-1">10+</div>
                                    <div class="text-xs font-label font-bold uppercase tracking-widest text-slate-500">Zendesk Public Apps</div>
                                </div>
                                <div class="p-6 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-slate-800">
                                    <div class="text-3xl font-headline font-black text-teal-700 dark:text-teal-400 mb-1">7+</div>
                                    <div class="text-xs font-label font-bold uppercase tracking-widest text-slate-500">Countries Clients Served</div>
                                </div>
                            </div>
                        </div>
                        <a class="mt-8 flex items-center justify-between group/link hover:text-emerald-700 transition-colors pt-4 border-t border-slate-100 dark:border-slate-800" href="/portfolio">
                            <span class="font-headline font-extrabold text-slate-900 dark:text-white group-hover/link:text-emerald-700 dark:group-hover/link:text-emerald-400 transition-colors">View Digital Solutions Portfolio</span>
                            <span class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center group-hover/link:bg-emerald-600 group-hover/link:text-white transition-all">
                                <span class="material-symbols-outlined text-lg" data-icon="arrow_forward">arrow_forward</span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Digital Integration Showcase -->
        <section class="py-24 bg-[#081c19] text-white rounded-t-[3rem] mt-12">
            <div class="max-w-7xl mx-auto px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div>
                        <span class="font-label font-bold text-emerald-400 uppercase tracking-[0.3em] text-xs mb-4 block">Integration Layer</span>
                        <h2 class="text-4xl md:text-5xl font-headline font-black text-white mb-8">Digital Integration &amp; SaaS Problem Solving</h2>
                        <ul class="space-y-6">
                            <li class="flex items-start gap-4">
                                <span class="material-symbols-outlined text-emerald-400 p-2.5 bg-emerald-500/10 border border-emerald-500/20 rounded-xl" data-icon="link">link</span>
                                <div>
                                    <h4 class="text-white font-headline font-bold text-xl mb-1">Unified SaaS Ecosystems</h4>
                                    <p class="text-slate-300">Connecting your Zendesk support, Shopify store, and internal systems into a single, seamless operational flow.</p>
                                </div>
                            </li>
                            <li class="flex items-start gap-4">
                                <span class="material-symbols-outlined text-emerald-400 p-2.5 bg-emerald-500/10 border border-emerald-500/20 rounded-xl" data-icon="troubleshoot">troubleshoot</span>
                                <div>
                                    <h4 class="text-white font-headline font-bold text-xl mb-1">Eliminating Workflow Friction</h4>
                                    <p class="text-slate-300">Auditing business processes to identify and eliminate redundant workloads, then automating tasks that slow teams down.</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="bg-[#040f0d] border border-emerald-900/50 rounded-3xl p-8 shadow-2xl relative overflow-hidden">
                        <div class="flex items-center gap-2 mb-6">
                            <div class="w-3 h-3 rounded-full bg-red-500/40"></div>
                            <div class="w-3 h-3 rounded-full bg-amber-500/40"></div>
                            <div class="w-3 h-3 rounded-full bg-emerald-500/40"></div>
                            <span class="ml-4 font-label text-xs text-slate-400 uppercase tracking-widest font-bold">optimizer.js</span>
                        </div>
                        <pre class="font-mono text-sm leading-relaxed text-slate-300"><span class="text-emerald-400">const</span> <span class="text-teal-300">sakarKhatiwada</span> = {'{'}
  <span class="text-amber-300">systems</span>: [<span class="text-emerald-300">"Zendesk"</span>, <span class="text-emerald-300">"Shopify"</span>, <span class="text-emerald-300">"Management Systems"</span>],
  <span class="text-amber-300">goal</span>: <span class="text-emerald-300">"Reduce Workflow Friction"</span>,

  <span class="text-emerald-400">async</span> <span class="text-teal-300">automateTasks</span>(process) {'{'}
    <span class="text-slate-500">// Audit process to eliminate redundant workload</span>
    <span class="text-emerald-400">const</span> optimized = <span class="text-emerald-400">await</span> process.<span class="text-teal-300">analyze</span>().<span class="text-teal-300">simplify</span>();
    
    <span class="text-emerald-400">return</span> {'{'}
      status: <span class="text-teal-300">"Seamless Flow"</span>,
      value: <span class="text-teal-300">"High Yield Results"</span>
    {'}'};
  {'}'}
{'}'};</pre>
                        <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-emerald-500/10 blur-[60px] rounded-full pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-28 bg-white dark:bg-slate-900 text-center px-8 border-t border-slate-200/80 dark:border-slate-800">
            <h2 class="text-5xl md:text-6xl font-headline font-black text-slate-900 dark:text-white mb-8 tracking-tight">
                Let's Build <br/> <span class="text-emerald-700 dark:text-emerald-400 italic">Something Remarkable.</span>
            </h2>
            <div class="flex flex-col md:flex-row justify-center items-center gap-5">
                <a class="w-full md:w-auto bg-emerald-600 text-white px-10 py-4.5 rounded-full font-headline font-bold text-lg hover:bg-emerald-700 hover:scale-105 transition-all shadow-xl shadow-emerald-600/20" href="mailto:sakar@saaspal.us">
                    Start a Consultation
                </a>
                <a class="w-full md:w-auto flex items-center justify-center gap-2 px-10 py-4.5 rounded-full border-2 border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-headline font-bold text-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" href="/about">
                    View My Profile
                </a>
            </div>
        </section>
	</main>

    <style>
        .animate-fade-in-up {
            animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-spin-slow {
            animation: spin 30s linear infinite;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</BaseLayout>
