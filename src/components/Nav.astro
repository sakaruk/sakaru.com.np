---
const pathname = new URL(Astro.request.url).pathname;
const normalizedPath = pathname.replace(/\/+$/, '');

const isActive = (path: string) => {
    if (path === '' && (normalizedPath === '' || normalizedPath === '/')) return true;
    if (path !== '' && (normalizedPath === `/${path}` || normalizedPath.startsWith(`/${path}/`))) return true;
    return false;
};
---

<header class="fixed top-0 w-full z-50 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 z-[9999] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 py-3.5 md:py-4 flex flex-col md:flex-row justify-between md:items-center">
    <div class="flex justify-between items-center w-full md:w-auto">
        <a href="/" class="flex items-center gap-2.5 text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 font-headline animate-fade-in group py-1">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 dark:bg-emerald-400 group-hover:scale-125 transition-transform duration-300"></span>
          <span>Sakar Upadhyaya Khatiwada</span>
        </a>
        <button 
            id="mobile-menu-trigger" 
            type="button"
            class="md:hidden text-slate-900 dark:text-slate-100 p-2.5 min-w-[44px] min-h-[44px] flex items-center justify-center cursor-pointer rounded-xl border border-slate-200/70 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:outline-none transition-all shadow-sm" 
            aria-label="Toggle navigation menu"
            aria-controls="nav-links"
            aria-expanded="false"
        >
            <span id="mobile-menu-icon" class="material-symbols-outlined select-none text-2xl" data-icon="menu">menu</span>
        </button>
    </div>
    
    <nav id="nav-links" class="hidden md:flex flex-col md:flex-row items-stretch md:items-center gap-1.5 md:gap-8 font-headline font-semibold tracking-tight mt-4 md:mt-0 pt-3 md:pt-0 pb-3 md:pb-0 border-t border-slate-200/80 dark:border-slate-800/80 md:border-t-0 w-full md:w-auto">
      <a 
        href="/"
        class={`w-full md:w-auto px-4 py-3 md:px-0 md:py-0 rounded-xl transition-all duration-200 flex items-center ${
            isActive('') 
                ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-bold md:bg-transparent md:border-b-2 md:border-emerald-600 md:dark:border-emerald-400 md:rounded-none md:pb-0.5' 
                : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/70 md:hover:bg-transparent md:dark:hover:bg-transparent md:hover:text-emerald-700 md:dark:hover:text-emerald-400'
        }`}
      >
        Home
      </a>
      <a 
        href="/about"
        class={`w-full md:w-auto px-4 py-3 md:px-0 md:py-0 rounded-xl transition-all duration-200 flex items-center ${
            isActive('about') 
                ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-bold md:bg-transparent md:border-b-2 md:border-emerald-600 md:dark:border-emerald-400 md:rounded-none md:pb-0.5' 
                : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/70 md:hover:bg-transparent md:dark:hover:bg-transparent md:hover:text-emerald-700 md:dark:hover:text-emerald-400'
        }`}
      >
        About
      </a>
      <a 
        href="/portfolio"
        class={`w-full md:w-auto px-4 py-3 md:px-0 md:py-0 rounded-xl transition-all duration-200 flex items-center ${
            isActive('portfolio') 
                ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-bold md:bg-transparent md:border-b-2 md:border-emerald-600 md:dark:border-emerald-400 md:rounded-none md:pb-0.5' 
                : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/70 md:hover:bg-transparent md:dark:hover:bg-transparent md:hover:text-emerald-700 md:dark:hover:text-emerald-400'
        }`}
      >
        Portfolio
      </a>
      <a 
        href="/community"
        class={`w-full md:w-auto px-4 py-3 md:px-0 md:py-0 rounded-xl transition-all duration-200 flex items-center ${
            isActive('community') 
                ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-bold md:bg-transparent md:border-b-2 md:border-emerald-600 md:dark:border-emerald-400 md:rounded-none md:pb-0.5' 
                : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/70 md:hover:bg-transparent md:dark:hover:bg-transparent md:hover:text-emerald-700 md:dark:hover:text-emerald-400'
        }`}
      >
        Community
      </a>
    </nav>
  </div>
</header>
<script is:inline>
    const menuBtn = document.getElementById('mobile-menu-trigger');
    const navLinks = document.getElementById('nav-links');
    const menuIcon = document.getElementById('mobile-menu-icon');
    
    menuBtn?.addEventListener('click', () => {
        const isHidden = navLinks?.classList.contains('hidden');
        navLinks?.classList.toggle('hidden');
        navLinks?.classList.toggle('flex');
        
        const nowOpen = isHidden;
        menuBtn.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
        if (menuIcon) {
            menuIcon.textContent = nowOpen ? 'close' : 'menu';
        }
    });

    document.querySelectorAll('#nav-links a').forEach(link => {
        link.addEventListener('click', () => {
            if (window.innerWidth < 768) {
                navLinks?.classList.add('hidden');
                navLinks?.classList.remove('flex');
                menuBtn?.setAttribute('aria-expanded', 'false');
                if (menuIcon) menuIcon.textContent = 'menu';
            }
        });
    });
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>
