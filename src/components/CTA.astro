---
export interface Props {
  badge?: string;
  titlePrefix?: string;
  titleHighlight?: string;
  description?: string;
  primaryButtonText?: string;
  primaryButtonHref?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
  secondaryButtonTarget?: string;
  className?: string;
}

const pathname = new URL(Astro.request.url).pathname;
const isAboutPage = pathname.replace(/\.html$/, '').replace(/\/+$/, '') === '/about';

const {
  badge = "Ready for the Next Phase?",
  titlePrefix = "Let's Build",
  titleHighlight = "Something Remarkable.",
  description = "Available for architectural consultations and system integration projects. Whether you're scaling your Shopify store or streamlining your CX operations via Zendesk, let's eliminate the friction holding your team back.",
  primaryButtonText = "Start a Consultation",
  primaryButtonHref = "mailto:sakar@saaspal.us",
  secondaryButtonText = isAboutPage ? "Connect on LinkedIn" : "View My Profile",
  secondaryButtonHref = isAboutPage ? "https://linkedin.com/in/sakaruk" : "/about",
  secondaryButtonTarget = isAboutPage ? "_blank" : undefined,
  className = ""
} = Astro.props;

const resolvedSecondaryTarget = secondaryButtonTarget ?? (secondaryButtonHref.startsWith('http') ? '_blank' : undefined);
---

<section class={`max-w-7xl mx-auto px-6 sm:px-8 py-16 sm:py-24 md:py-28 bg-white dark:bg-slate-900 rounded-[2.5rem] sm:rounded-[3rem] text-center mb-10 gsap-reveal shadow-xl border border-slate-200/80 dark:border-slate-800 relative overflow-hidden isolate [mask-image:-webkit-radial-gradient(white,black)] ${className}`}>
  <!-- Subtle Internal Radial Accents (No negative margin blurs to prevent Safari corner bleeding) -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(16,185,129,0.08),transparent_50%)] dark:bg-[radial-gradient(circle_at_top_left,rgba(16,185,129,0.05),transparent_50%)] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_right,rgba(20,184,166,0.08),transparent_50%)] dark:bg-[radial-gradient(circle_at_bottom_right,rgba(20,184,166,0.05),transparent_50%)] pointer-events-none"></div>
  
  <div class="max-w-3xl mx-auto relative z-10">
    {badge && (
      <span class="font-label text-xs uppercase tracking-widest text-emerald-700 dark:text-emerald-400 font-bold mb-4 sm:mb-6 block">
        {badge}
      </span>
    )}
    
    <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-headline font-black text-slate-900 dark:text-white mb-6 md:mb-8 tracking-tight">
      {titlePrefix} <br class="hidden sm:inline"/> <span class="text-emerald-700 dark:text-emerald-400 italic">{titleHighlight}</span>
    </h2>
    
    {description && (
      <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg md:text-xl mb-8 md:mb-12 leading-relaxed">
        {description}
      </p>
    )}
    
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-5">
      {primaryButtonText && primaryButtonHref && (
        <a 
          class="w-full sm:w-auto bg-emerald-600 text-white px-8 sm:px-10 py-4 rounded-full font-headline font-bold text-base sm:text-lg hover:bg-emerald-700 hover:scale-105 transition-all shadow-xl shadow-emerald-600/20" 
          href={primaryButtonHref}
        >
          {primaryButtonText}
        </a>
      )}
      {secondaryButtonText && secondaryButtonHref && (
        <a 
          class="w-full sm:w-auto flex items-center justify-center gap-2 px-8 sm:px-10 py-4 rounded-full border-2 border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-headline font-bold text-base sm:text-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" 
          href={secondaryButtonHref}
          target={resolvedSecondaryTarget}
          rel={resolvedSecondaryTarget === '_blank' ? 'nofollow noopener noreferrer' : undefined}
        >
          {secondaryButtonText}
        </a>
      )}
    </div>
  </div>
</section>
