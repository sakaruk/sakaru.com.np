---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  content: {
    title: string;
    description?: string;
    thumbnail?: string;
    date?: string;
    author?: string;
    readingTime?: string;
    tag?: string;
  };
}

const { content } = Astro.props;
---
<BaseLayout 
  title={`${content.title} | Sakar Upadhyaya Khatiwada`} 
  description={content.description} 
  image={content.thumbnail}
>

	<main class="pt-32 pb-20 min-h-[85vh]">
		<article class="max-w-4xl mx-auto px-8 prose prose-lg prose-emerald dark:prose-invert">
            <div class="mb-12 not-prose">
                <time class="font-label text-sm text-slate-500 dark:text-slate-400 uppercase tracking-widest">{content.date}</time>
                <h1 class="text-5xl font-headline font-extrabold tracking-tighter text-slate-900 dark:text-white mt-2 mb-6 leading-tight">
                    {content.title}
                </h1>
                <div class="flex items-center gap-6 mb-8 text-slate-600 dark:text-slate-300 font-body text-sm">
                    {content.author && (
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-base" data-icon="person">person</span>
                            <span>{content.author}</span>
                        </div>
                    )}
                    {content.readingTime && (
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-base" data-icon="schedule">schedule</span>
                            <span>{content.readingTime}</span>
                        </div>
                    )}
                    {content.tag && (
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-base" data-icon="label">label</span>
                            <span class="text-xs font-label font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-500/10 dark:bg-emerald-950/60 border border-emerald-500/20 dark:border-emerald-800/50 px-3 py-1 rounded-full">{content.tag}</span>
                        </div>
                    )}
                </div>
            </div>
            
            {content.thumbnail && (
                <div class="w-full aspect-[21/9] overflow-hidden rounded-2xl mb-12 not-prose">
                    <img src={content.thumbnail} alt={content.title} class="w-full h-full object-cover" width="1200" height="514" loading="eager" fetchpriority="high" decoding="async" />
                </div>
            )}
            
			<slot />
		</article>
	</main>
</BaseLayout>
