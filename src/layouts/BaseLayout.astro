---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/tailwind.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8"/>
	<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
	<title>{title || "Sakar Upadhyaya Khatiwada | The Kinetic Architect"}</title>
    
    <SEO title={title} description={description} image={image} />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500;600&family=Space_Grotesk:wght@500;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet"/>

    <script is:inline>
      (function() {
        const path = window.location.pathname;
        if (path !== '/' && (path.endsWith('/') || path.endsWith('.html'))) {
          const cleanPath = path.replace(/\.html$/, '').replace(/\/+$/, '') + window.location.search + window.location.hash;
          const cleanUrl = window.location.origin + cleanPath;
          window.location.replace(cleanUrl);
        }
      })();
    </script>

    <script is:inline>
      (function() {
        try {
          const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');
          
          function applyTheme(isDark) {
            if (isDark) {
              document.documentElement.classList.add('dark');
              document.documentElement.classList.remove('light');
            } else {
              document.documentElement.classList.add('light');
              document.documentElement.classList.remove('dark');
            }
          }

          // Apply dark mode if preferred by browser settings, otherwise default to light
          applyTheme(darkModeQuery && darkModeQuery.matches);

          // Update dynamically if browser/OS preference changes
          if (darkModeQuery && darkModeQuery.addEventListener) {
            darkModeQuery.addEventListener('change', function(e) {
              applyTheme(e.matches);
            });
          }
        } catch (e) {
          // Default fallback to light
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {import.meta.env.PROD && (
      <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "y5fmlt9aau");
      </script>
    )}
	<style>
		:root {
			--primary: #008060;
			--primary-dark: #004c3f;
			--secondary: #0f766e;
			--tertiary: #059669;
			--color-primary-rgb: 0, 128, 96;
		}
		:root.dark, .dark {
			--primary: #34d399;
			--primary-dark: #059669;
			--secondary: #2dd4bf;
			--tertiary: #10b981;
			--color-primary-rgb: 52, 211, 153;
		}
		.kinetic-gradient {
			background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
		}
		.timeline-line {
			background: linear-gradient(to bottom, var(--primary), var(--tertiary), transparent);
		}
        .kinetic-architect-bg {
			background: radial-gradient(circle at 0% 0%, rgba(var(--color-primary-rgb), 0.04) 0%, transparent 50%),
						radial-gradient(circle at 100% 100%, rgba(15, 118, 110, 0.04) 0%, transparent 50%);
		}
		strong, b {
			color: var(--primary);
			font-weight: 600;
		}
		/* Ensure prose strong tags also match */
		.prose strong {
			color: var(--primary) !important;
		}
		::selection {
			background-color: #059669;
			color: #ffffff;
		}
		:root.dark ::selection, .dark ::selection {
			background-color: #34d399;
			color: #020617;
		}
	</style>
</head>
<body class="bg-background font-body text-on-surface antialiased transition-colors duration-300 selection:bg-emerald-600 selection:text-white dark:selection:bg-emerald-400 dark:selection:text-slate-950">
	<Nav />
	
	<slot />

	<Footer />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer is:inline></script>
    <script is:inline>
        // Global GSAP Initiation - non-blocking after scripts load
        function initGSAP() {
            if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
                gsap.registerPlugin(ScrollTrigger);

                const revealElements = document.querySelectorAll(".gsap-reveal");
                revealElements.forEach((el) => {
                    gsap.fromTo(el, 
                        { opacity: 0, y: 30 }, 
                        { 
                            opacity: 1, 
                            y: 0, 
                            duration: 0.8, 
                            ease: "power2.out",
                            scrollTrigger: {
                                trigger: el,
                                start: "top 85%", // Triggers when the top of element hits 85% of viewport
                            }
                        }
                    );
                });
            } else {
                setTimeout(initGSAP, 50);
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener("DOMContentLoaded", initGSAP);
        } else {
            initGSAP();
        }
    </script>
</body>
</html>
