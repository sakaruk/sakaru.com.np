{
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "overrides": [
        {
            "files": [
                "*.astro"
            ],
            "extends": [
                "plugin:astro/recommended"
            ],
            "parser": "astro-eslint-parser",
            "parserOptions": {
                "parser": "@typescript-eslint/parser",
                "extraFileExtensions": [
                    ".astro"
                ]
            },
            "rules": {}
        },
        {
            "files": [
                "*.ts"
            ],
            "extends": [
                "airbnb-base",
                "airbnb-base-typescript",
                "prettier"
            ],
            "rules": {
                "jest/no-deprecated-functions": "off",
                "import/no-cycle": "off",
                "no-param-reassign": "off"
            },
            "env": {
                "browser": true,
                "jest": true
            }
        }
    ],
    "ignorePatterns": [
        "*.d.ts"
    ]
}