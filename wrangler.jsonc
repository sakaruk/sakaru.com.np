{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sakaru-com-np",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"pages_build_output_dir": "./dist"
}